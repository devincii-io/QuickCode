/* QuickCode dark theme — structured, calm, high-contrast where it matters. */

Screen {
    background: $surface;
    color: $text;
}

#body {
    height: 1fr;
}

#transcript {
    width: 1fr;
    height: 1fr;
    background: $surface;
    padding: 1 2;
    scrollbar-gutter: stable;
}

/* Task board sidebar (Ctrl+B) */
#sidebar {
    width: 34;
    height: 1fr;
    background: $panel;
    color: $text;
    border-left: vkey $primary-darken-2;
    padding: 1 2;
}

/* ---- input ---------------------------------------------------------- */
/* No dock: input flows just above the status bar, never inside it. The bar
   itself has no fill — only a thin border — so it reads as a light divider,
   not a heavy panel. */
#input-area {
    height: auto;
    background: $surface;
    border: round $border;
    border-title-color: $accent;
    padding: 0 1;
    margin: 0 1;
}

#input-area:focus-within {
    border: round $accent;
}

#chat-input {
    height: auto;
    min-height: 1;
    max-height: 8;
    background: $surface;
    border: none;
    padding: 0;
}

#chat-input:focus {
    background: $surface;
}

/* ---- status bar (segmented) ---------------------------------------- */
StatusBar {
    height: 1;
    background: $panel-darken-1;
}

StatusBar Static {
    height: 1;
    width: auto;
    content-align: center middle;
}

#seg-model {
    color: $text;
    background: $boost;
    text-style: bold;
}

#seg-ctx {
    color: $text-muted;
}

#seg-cost {
    color: $success;
}

#seg-state {
    color: $text-muted;
}

/* mode segment recolored by class (warm palette, no blue) */
.mode-plan {
    color: $background;
    background: $secondary;
    text-style: bold;
}

.mode-ask {
    color: $background;
    background: $primary;
    text-style: bold;
}

.mode-auto-edit {
    color: $background;
    background: $warning;
    text-style: bold;
}

.mode-yolo {
    color: white;
    background: $error-darken-1;
    text-style: bold;
}

/* ---- transcript content -------------------------------------------- */
.banner-notice {
    background: #7c2d12;
    color: white;
    padding: 0 1;
    margin: 0 0 1 0;
}

/* Plain messages, left-aligned. User lines get a "› " accent prefix; the
   assistant renders as flush-left Markdown. padding:0 overrides Textual
   Markdown's built-in 0 2 so there's no phantom indent. */
.msg-user {
    color: $accent;
    text-style: bold;
    margin: 1 0 0 0;
}

.msg-assistant {
    color: $text;
    padding: 0;
    margin: 0 0 1 0;
}

.msg-reasoning {
    color: $text-muted;
    text-style: italic;
}

/* Collapsible "✱ Thinking" block. */
.reasoning-box {
    margin: 0 0 1 0;
    color: $text-muted;
}

.reasoning-box CollapsibleTitle {
    color: $text-muted;
    text-style: italic;
}

.tool-header {
    color: $secondary;
    text-style: bold;
}

.tool-result-ok {
    color: $text-muted;
}

.tool-result-error {
    color: $error;
    text-style: bold;
}

/* ---- modals -------------------------------------------------------- */
PermissionModal {
    align: center middle;
}

PermissionModal > Vertical {
    width: 70%;
    max-width: 90;
    height: auto;
    border: round $primary;
    background: $panel;
    padding: 1 2;
}

PermissionModal Horizontal {
    height: auto;
    margin: 1 0 0 0;
}

PermissionModal Button {
    margin: 0 1 0 0;
}

HelpScreen {
    align: center middle;
}

HelpScreen > Vertical {
    width: 60%;
    max-width: 90;
    height: auto;
    border: round $primary;
    background: $panel;
    padding: 1 2;
}

SettingsScreen {
    align: center middle;
}

SettingsScreen > Vertical {
    width: 90%;
    height: 90%;
    border: round $primary;
    background: $panel;
    padding: 1 2;
}

SettingsScreen .key-buttons {
    height: auto;
    margin: 1 0;
}

SettingsScreen .key-buttons Button {
    margin: 0 1 0 0;
}

.model-row {
    height: auto;
}
